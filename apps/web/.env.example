# AUREVANE environment identity. These two values must always match.
NEXT_PUBLIC_AUREVANE_ENV=local
AUREVANE_ENV=local

# Browser-safe Supabase connection values.
# For local development, use the API URL and anon/publishable key shown by `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key

# SERVER ONLY. Never rename this with a NEXT_PUBLIC_ prefix.
# Only required by code that performs explicitly privileged server operations.
# For local development this may be the local service_role key; hosted projects should use an sb_secret_ key.
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
